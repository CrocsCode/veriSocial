  "query": "\n        SELECT\n            c.comment_id,\n            c.post_id,\n            c.user_id,\n            u.username,\n            u.full_name,\n            c.content,\n            c.created_at,\n            c.bot_score,\n            CAST(0 AS UNSIGNED) AS likes_count,\n            0 AS is_liked\n        FROM\n            comments AS c\n        INNER JOIN\n            users AS u ON c.user_id = u.user_id\n        WHERE\n            c.comment_id = ?;\n        ",
