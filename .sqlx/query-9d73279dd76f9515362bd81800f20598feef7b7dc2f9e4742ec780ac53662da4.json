  "db_name": "MySQL",
  "query": "\n        SELECT\n            p.post_id,\n            p.user_id,\n            p.content,\n            p.created_at,\n            u.username,\n            u.full_name\n        FROM\n            posts AS p\n        INNER JOIN\n            users AS u ON p.user_id = u.user_id\n        INNER JOIN\n            follow f ON p.user_id = f.followee_id\n        WHERE\n            f.follower_id = ?\n        ORDER BY\n            created_at\n        ",
