  "db_name": "MySQL",
  "query": "\n            SELECT\n                r.report_id,\n                r.user_id AS reportee_id,\n                p.user_id AS reported_id,\n                r.post_id,\n                r.ai_content AS `ai_content: bool`,\n                r.bot_behaviour AS `bot_behaviour: bool`,\n                r.other AS `other: bool`,\n                r.additional_details,\n                r.created_at\n            FROM\n                reports AS r\n            LEFT JOIN\n                posts AS p ON r.post_id = p.post_id\n            WHERE\n                r.report_id = ?;\n            ",
